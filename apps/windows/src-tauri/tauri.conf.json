{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Subscribe",
  "version": "0.1.0",
  "identifier": "com.aisubscribe.desktop",
  "build": {
    "beforeBuildCommand": "..\\..\\scripts\\pnpm-env.cmd --filter @ai-subscribe/windows build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "AI Subscribe",
        "width": 1100,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
